# Doxyfile - configuração da documentação do Camera Trap
#
# Gere a documentação na pasta raiz do projeto com:
#     doxygen Doxyfile
# e abra docs/doxygen/html/index.html no navegador.
#
# Só as opções que mudam algo foram listadas; as outras usam o padrão do
# Doxygen. Para ver todas as opções: doxygen -g Doxyfile.completo

#---------------------------------------------------------------------------
# Projeto
#---------------------------------------------------------------------------
PROJECT_NAME           = "Camera Trap"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Observação de animais com Raspberry Pi Zero W, câmera e sensor HC-SR04"
OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = Brazilian

#---------------------------------------------------------------------------
# Python
#---------------------------------------------------------------------------
# Deixa a saída com cara de linguagem orientada a objetos (recomendado para Python).
OPTIMIZE_OUTPUT_JAVA   = YES
# NO = os comandos @brief, @param etc. dentro das docstrings são interpretados.
# (Opção existe a partir do Doxygen 1.9.1.)
PYTHON_DOCSTRING       = NO

#---------------------------------------------------------------------------
# O que documentar
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
SORT_MEMBER_DOCS       = NO
MARKDOWN_SUPPORT       = YES

#---------------------------------------------------------------------------
# Arquivos de entrada
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         docs \
                         src/cameratrap \
                         scripts
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.py \
                         *.md
RECURSIVE              = YES
EXCLUDE                = docs/doxygen
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH             = docs/img \
                         assets

#---------------------------------------------------------------------------
# Código-fonte na documentação
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO

#---------------------------------------------------------------------------
# Saída
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Diagramas (precisa do Graphviz instalado; se não tiver, troque para NO)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

#---------------------------------------------------------------------------
# Mensagens
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
